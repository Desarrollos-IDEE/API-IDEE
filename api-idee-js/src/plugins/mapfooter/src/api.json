{
  "url": {
    "name": "mapfooter",
    "separator": "*"
  },
  "constructor": "IDEE.plugin.Mapfooter",
  "parameters": [
    {
      "type": "simple",
      "name": "position",
      "position": 0,
      "possibleValues": [
        "left",
        "right",
        "center-bottom-left",
        "center-bottom-right",
        "center-top-left",
        "center-top-right",
        "down"
      ]
    },
    {
      "type": "boolean",
      "name": "collapsed",
      "position": 1
    },
    {
      "type": "number",
      "name": "order",
      "position": 2
    },
    {
      "type": "string",
      "name": "tooltip",
      "position": 3
    },
    {
      "type": "boolean",
      "name": "collapsible",
      "position": 4
    }
  ],
  "files": {
    "ol": {
      "scripts": ["mapfooter.ol.min.js"],
      "styles": ["mapfooter.ol.min.css"]
    },
    "cesium": {
      "scripts": ["mapfooter.cesium.min.js"],
      "styles": ["mapfooter.cesium.min.css"]
    }
  },
  "metadata": {
    "name": "Mapfooter",
    "description": "Pie HTML colapsable bajo el mapa (CollapsiblePanel)",
    "text": "Añade un pie de página HTML colapsable al mapa mediante CollapsiblePanel (API-IDEE v2). No usa SidePanel.",
    "version": "2.0.0",
    "date": "Septiembre, 2026",
    "author": "API-IDEE",
    "org": "Instituto Geográfico Nacional",
    "tags": "api-idee,IDEE,plugin",
    "icon": "https://componentes.idee.es/estaticos/Simbologia/svg/icons_cota/icn_info.svg",
    "centralized": true,
    "compatibility": ["2"]
  }
}
