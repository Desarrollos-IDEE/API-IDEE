{
  "url": {
    "name": "mapheader",
    "separator": "*"
  },
  "constructor": "IDEE.plugin.Mapheader",
  "parameters": [
    {
      "type": "simple",
      "name": "position",
      "position": 0,
      "possibleValues": [
        "left",
        "right",
        "center-bottom-left",
        "center-bottom-right",
        "center-top-left",
        "center-top-right",
        "down"
      ]
    },
    {
      "type": "boolean",
      "name": "collapsed",
      "position": 1
    },
    {
      "type": "number",
      "name": "order",
      "position": 2
    },
    {
      "type": "string",
      "name": "tooltip",
      "position": 3
    },
    {
      "type": "boolean",
      "name": "collapsible",
      "position": 4
    }
  ],
  "files": {
    "ol": {
      "scripts": [
        "mapheader.ol.min.js"
      ],
      "styles": [
        "mapheader.ol.min.css"
      ]
    },
    "cesium": {
      "scripts": [
        "mapheader.cesium.min.js"
      ],
      "styles": [
        "mapheader.cesium.min.css"
      ]
    }
  },
  "metadata": {
    "name": "Mapheader",
    "description": "Generador de Cabecera de Mapa",
    "text": "Cabecera HTML colapsable sobre el mapa con CollapsiblePanel (API-IDEE v2)",
    "version": "2.0.0",
    "date": "Septiembre, 2026",
    "author": "API-IDEE",
    "org": "Instituto Geográfico Nacional",
    "tags": "api-idee,IDEE,plugin",
    "icon": "https://componentes.idee.es/estaticos/Simbologia/svg/icons_cota/icn_info.svg",
    "centralized": true,
    "compatibility": [
      "2"
    ]
  }
}
