    {
      "type": "string",
      "name": "tooltip",
      "position": 3
    },
    {
      "type": "string",
      "name": "features",
      "position": 4
    },
    {
      "type": "string",
      "name": "layername",
      "position": 5
    },
    {
      "type": "simple",
      "name": "geometry",
      "position": 6,
      "possibleValues": [
        "POINT",
        "LINE",
        "POLYGON",
        "MPOINT",
        "MLINE",
        "MPOLYGON"
